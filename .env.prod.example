# ===== ParkingSystem PRODUCTION env =====
# مقادیر <GENERATE> را با secret تولیدشده جایگزین کنید (دستور در راهنما).
APP_NAME=Parking Management System
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=<GENERATE>
APP_TIMEZONE=Asia/Tehran

POSTGRES_USER=parking
POSTGRES_PASSWORD=<GENERATE>
POSTGRES_DB=parking_db

JWT_SECRET_KEY=<GENERATE>
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<GENERATE-STRONG>

GATE_API_KEY=<GENERATE>

MINIO_ACCESS_KEY=parkingminio
MINIO_SECRET_KEY=<GENERATE>
MINIO_BUCKET=parking-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRE_MINUTES=15

MAX_UPLOAD_SIZE_MB=25
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# پورت عمومی nginx روی سرور (اگر 80 آزاد نبود مثلا 8080)
APP_PORT=80