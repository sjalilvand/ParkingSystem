APP_NAME=Parking Management System
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-change-me-001
APP_TIMEZONE=Asia/Tehran

DATABASE_URL=postgresql+asyncpg://parking:parking_pass@127.0.0.1:5433/parking_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=dev-jwt-secret-change-me-001
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@1234

LOG_LEVEL=INFO
GATE_API_KEY=gate-dev-key
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=parking-files
MINIO_SECURE=false